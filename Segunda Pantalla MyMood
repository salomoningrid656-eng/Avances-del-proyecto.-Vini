<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"       android:background="#FFFFFF">

    <ImageView
        android:id="@+id/img_logo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="32dp"             android:contentDescription="Logo de la aplicación"
        android:src="@drawable/mymood" />

    <TextView
        android:id="@+id/tv_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bienvenido"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_titulo_iniciar_sesion" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar sesión"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="8dp"              android:textColor="#6200EE" />

    <EditText
        android:id="@+id/et_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre"
        android:textColor="#6200EE"
        android:layout_marginTop="24dp"             android:inputType="textPersonName" />       <EditText
    android:id="@+id/et_edad"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="Edad"
    android:textColor="#6200EE"
    android:layout_marginTop="16dp"
    android:inputType="number" />

    <EditText
        android:id="@+id/et_genero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Género"
        android:textColor="#6200EE"
        android:layout_marginTop="16dp"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/et_correo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Correo electrónico"
        android:textColor="#6200EE"
        android:layout_marginTop="16dp"
        android:inputType="textEmailAddress" />

    <EditText
        android:id="@+id/et_contrasena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Contraseña"
        android:textColor="#6200EE"
        android:layout_marginTop="16dp"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/btn_iniciar_sesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar sesión"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="24dp"             android:paddingVertical="12dp"
        app:cornerRadius="8dp" />

    <TextView
        android:id="@+id/tv_olvide_contrasena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Olvidaste tu contraseña?"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:textColor="#FF9800" />

</LinearLayout>